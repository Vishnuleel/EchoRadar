# All settings are optional. NEXUS runs fully without any of them.
# Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://...)
NEXUS_DATABASE_URL=sqlite:///data/nexus.db
# Embedding backend: "auto" (sentence-transformers, falls back to hashing), "st", or "hash"
NEXUS_EMBEDDINGS=auto
NEXUS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# OpenAlex: a free API key gives you your own quota (https://help.openalex.org/api/authentication/)
OPENALEX_API_KEY=
# Contact address sent to OpenAlex / in the crawler User-Agent (optional, polite-pool etiquette)
NEXUS_CONTACT_EMAIL=
# Optional: model-assisted extraction of website claims (every quote is checked against the page).
# Live check without changing any data: python scripts/check_gemini.py
NEXUS_LLM_EXTRACTION=
# Optional: Ask NEXUS questions the rules cannot place are sorted by Gemini into fixed question types.
# Visitor questions only (never questions asked as a company); answers still come only from stored records.
NEXUS_LLM_ROUTING=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# Sign-in: "demo" (selector, not authentication) or "token" (server-side tokens from a JSON file of sha256 -> slug)
NEXUS_AUTH_MODE=demo
NEXUS_AUTH_TOKENS=
# Set to 1 to forbid network access (use cached snapshot only; backup demo mode)
NEXUS_OFFLINE=0
